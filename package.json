{
  "name": "dsh-prompt-prediction",
  "version": "0.1.0",
  "description": "Predicts the user's next message after an agent reply and fills it into the empty composer on Tab",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "prediction",
    "ghost-text"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QingJ01/dsh-prompt-prediction.git"
  },
  "homepage": "https://github.com/QingJ01/dsh-prompt-prediction#readme",
  "bugs": {
    "url": "https://github.com/QingJ01/dsh-prompt-prediction/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./prediction": "./lib/prediction.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/prediction.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
