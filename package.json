{
  "name": "dsh-prompt-prediction",
  "version": "0.1.1",
  "description": "Unofficial DeepSeek Harness plugin for next-prompt ghost text; Tab or ArrowRight fills an editable draft without sending it.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "composer",
    "prediction",
    "ghost-text",
    "prompt-prediction",
    "autocomplete"
  ],
  "license": "MIT",
  "author": {
    "name": "QingJ",
    "url": "https://github.com/QingJ01"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QingJ01/dsh-prompt-prediction.git"
  },
  "homepage": "https://github.com/QingJ01/dsh-prompt-prediction#readme",
  "bugs": {
    "url": "https://github.com/QingJ01/dsh-prompt-prediction/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./prediction": "./lib/prediction.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/prediction.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs/images/preview.png",
    "locale/*.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  }
}
